{"duration_s": 7.784, "reference_text": "De belastingverhoging op cultuur, media en sport was ongewenst.", "relative_path": "common_voice_nl_43559163.mp3", "speaker_age_bucket": "seventies", "speaker_gender": null, "utterance_id": "common_voice_nl_43559163"}
{"duration_s": 8.864, "reference_text": "Hetzelfde geldt voor de voorstellen die worden gedaan over de respectieve politieke stichtingen.", "relative_path": "common_voice_nl_43559164.mp3", "speaker_age_bucket": "seventies", "speaker_gender": null, "utterance_id": "common_voice_nl_43559164"}
{"duration_s": 6.955, "reference_text": "Zoals u weet kan onze fractie geen steun verlenen aan nucleaire technologie.", "relative_path": "common_voice_nl_26967076.mp3", "speaker_age_bucket": "nineties", "speaker_gender": "male_masculine", "utterance_id": "common_voice_nl_26967076"}
