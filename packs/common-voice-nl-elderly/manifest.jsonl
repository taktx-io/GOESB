{"duration_s": 7.423, "reference_text": "Deze week heb ik een aantal iatrogene pati\u00ebnten ontmoet.", "relative_path": "common_voice_nl_43559169.mp3", "speaker_age_bucket": "seventies", "speaker_gender": null, "utterance_id": "common_voice_nl_43559169"}
{"duration_s": 7.784, "reference_text": "Dat wil dus zeggen aan de uitslag, zoals die gisteren bekend is gemaakt.", "relative_path": "common_voice_nl_43559170.mp3", "speaker_age_bucket": "seventies", "speaker_gender": null, "utterance_id": "common_voice_nl_43559170"}
