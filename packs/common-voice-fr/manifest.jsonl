{"audio_sha256": "3852207ad77c097ff6b034012f25139c894f5651023891ba1bdfb11836f3915c", "duration_s": 6.27, "reference_text": "J'ai dit que les acteurs de bois avaient, selon moi, beaucoup d'avantages sur les autres.", "relative_path": "common_voice_fr_18027195.mp3", "speaker_age_bucket": null, "speaker_gender": null, "utterance_id": "common_voice_fr_18027195"}
