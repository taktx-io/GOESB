{"audio_sha256": "41689c7f392783d73d67adefe8b56c4a623eccc803d98ca64b1756cb928e5ae8", "duration_s": 6.343, "reference_text": "Son actionnaire majoritaire est le Conseil territorial de Saint-Pierre-et-Miquelon.", "relative_path": "common_voice_fr_27024649.mp3", "speaker_age_bucket": null, "speaker_gender": null, "utterance_id": "common_voice_fr_27024649"}
