{"audio_sha256": "e45523b101b23113f343c17d556420b3a9f386be113a43ef28ef9db25f0414e9", "duration_s": 4.976, "reference_text": "Aber wei\u00dft du, wer den Stein wirklich ins Rollen gebracht hat?", "relative_path": "common_voice_de_27395829.mp3", "speaker_age_bucket": null, "speaker_gender": null, "utterance_id": "common_voice_de_27395829"}
