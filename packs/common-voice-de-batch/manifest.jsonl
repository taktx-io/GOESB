{"audio_sha256": "ece3c53c5383e56a770587301544f5376b02da9fdd434e89539b19cd5151dd27", "duration_s": 6.036, "reference_text": "L\u00e4nder der Dritten Welt brauchen keine Almosen.", "relative_path": "common_voice_de_40341023.mp3", "speaker_age_bucket": null, "speaker_gender": null, "utterance_id": "common_voice_de_40341023"}
