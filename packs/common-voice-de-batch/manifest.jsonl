{"audio_sha256": "026455afd76a405e0c5ea491d0d26f089aa6c92c5363e6e954f1764682ad1561", "duration_s": 4.255, "reference_text": "Sie gewannen das Match mit sechs L\u00f6chern Vorsprung.", "relative_path": "common_voice_de_30624469.mp3", "speaker_age_bucket": null, "speaker_gender": null, "utterance_id": "common_voice_de_30624469"}
{"audio_sha256": "670cc8403eddbcd836314c10ff1351e34c5a424c7da8ae80545d238d6c510302", "duration_s": 7.662, "reference_text": "Die Wagen erhielten ein einheitliches Erscheinungsbild in wei\u00df mit rotem Fensterband.", "relative_path": "common_voice_de_23689441.mp3", "speaker_age_bucket": null, "speaker_gender": null, "utterance_id": "common_voice_de_23689441"}
