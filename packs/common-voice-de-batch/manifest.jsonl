{"audio_sha256": "f92464aa6920df0aed4dac1e56d9d8b4fc69b52c22a88e663d0b80b37cfff141", "duration_s": 4.65, "reference_text": "Was solls, ich bin bereit.", "relative_path": "common_voice_de_18520278.mp3", "speaker_age_bucket": "thirties", "speaker_gender": "male_masculine", "utterance_id": "common_voice_de_18520278"}
{"audio_sha256": "f135c57cf3ea8395497292d6f9663fe82804c504a60ede173200230e2ef4cffd", "duration_s": 9.116, "reference_text": "Sein Atelier diente nebenher zur Tarnung unerlaubter politischer Aktivit\u00e4ten.", "relative_path": "common_voice_de_27022744.mp3", "speaker_age_bucket": null, "speaker_gender": null, "utterance_id": "common_voice_de_27022744"}
{"audio_sha256": "b3d0f893396c7f9e01f5e5f61202289f820a9dd5a778e9507d7bb9739c8ae919", "duration_s": 6.534, "reference_text": "Das Internet besteht aus vielen Computern, die miteinander verbunden sind.", "relative_path": "common_voice_de_18204372.mp3", "speaker_age_bucket": null, "speaker_gender": null, "utterance_id": "common_voice_de_18204372"}
