{"audio_sha256": "da990656022d61c09406a206c2500039e9f89538b76520c9fbd1bf90e3095aae", "duration_s": 4.795, "reference_text": "Mit den Senators nahm er an drei All-Star-Spielen teil.", "relative_path": "common_voice_de_25211223.mp3", "speaker_age_bucket": null, "speaker_gender": null, "utterance_id": "common_voice_de_25211223"}
