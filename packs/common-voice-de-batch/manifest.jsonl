{"audio_sha256": "f7e667cc4d6a14abe2389c10074ee7036a5f0bc6fa2cc77d6289670822df64ce", "duration_s": 4.112, "reference_text": "Es gibt auch mehrere Campingpl\u00e4tze.", "relative_path": "common_voice_de_27060918.mp3", "speaker_age_bucket": null, "speaker_gender": null, "utterance_id": "common_voice_de_27060918"}
{"audio_sha256": "4a055f3664555bfb43bc939f518ad3f01c754265cd714bb5eda2db22c6691f23", "duration_s": 5.784, "reference_text": "Als Kind wollte er nach eigenen Aussagen Footballspieler werden.", "relative_path": "common_voice_de_36992722.mp3", "speaker_age_bucket": null, "speaker_gender": null, "utterance_id": "common_voice_de_36992722"}
{"audio_sha256": "529e3d49f41ae7d15924de71ae57e0345ea14b368cadb52cc989f8391043d930", "duration_s": 5.166, "reference_text": "Es kommt zum Showdown in Gstaad.", "relative_path": "common_voice_de_19728810.mp3", "speaker_age_bucket": null, "speaker_gender": null, "utterance_id": "common_voice_de_19728810"}
