{"audio_sha256": "b739b0f120e2804d6e38e130f06ab002ef52f8c8a682c971bd4660294926616c", "duration_s": 12.139, "reference_text": "Hierzu z\u00e4hlt der K\u00fcnstler \"Radikale Malerei\" und \"Minimal Art\".", "relative_path": "common_voice_de_43374102.mp3", "speaker_age_bucket": null, "speaker_gender": null, "utterance_id": "common_voice_de_43374102"}
