{"audio_sha256": "9bfd039becdc7457ae2e3d17c00ce6f4a2228020973cb0a99b7c14b620e238ff", "duration_s": 4.992, "reference_text": "Die Herkunft des Namens ist nicht eindeutig gekl\u00e4rt.", "relative_path": "common_voice_de_43373376.mp3", "speaker_age_bucket": "twenties", "speaker_gender": null, "utterance_id": "common_voice_de_43373376"}
